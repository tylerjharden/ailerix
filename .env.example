# Optional. When set, Ailerix calls TypeSafe Jev instead of the local System One engine.
# TYPESAFE_API_KEY=

# Optional. Prisma Postgres for route-event analytics. Without it, analytics use an
# in-memory ring buffer (last 500 events) that resets on restart.
# DATABASE_URL=

# Optional provider keys. Absence narrows routing eligibility to executable models;
# with zero keys, requests execute on the deterministic ailerix/echo-local adapter.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# DASHSCOPE_API_KEY=

# Optional. Gates /api/v1/internal/catalog and /api/v1/analytics/* in production.
# AILERIX_OPERATOR_KEY=

# Optional. Clerk authentication (dashboard sign-in, session API keys). In development,
# Clerk Keyless can run without keys. For production, set both publishable and secret.
# MCP OAuth (G6) verifies bearer tokens only when CLERK_SECRET_KEY is set; keyless dev
# serves MCP tools 1–4 without auth and returns sign_in_required on credit tools.
# In the Clerk dashboard: enable Dynamic Client Registration (or CIMD) for MCP OAuth and
# register Cursor redirect URLs:
#   https://www.cursor.com/agents/mcp/oauth/callback
#   http://localhost:8787/callback
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Optional. Stripe credit top-ups (human checkout + webhook). Without STRIPE_SECRET_KEY,
# checkout returns 503 stripe_not_configured and purchase buttons stay disabled.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Public site URL for Stripe success/cancel redirects (defaults to request Origin).
# NEXT_PUBLIC_APP_URL=https://ailerix.com
